{
  "expo": {
    "name": "AgroTraz Campo",
    "slug": "agrotraz-campo",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.agrotraz.campo",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1d3b2a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "AgroTraz usa tu ubicación para georreferenciar las evaluaciones fitosanitarias."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AgroTraz usa la cámara para fotografiar los síntomas en campo."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8b4b7045-b2ba-48a8-95ae-9cff62a44d49"
      }
    },
    "owner": "paula001s-team"
  }
}
